@@ -241,8 +264,56 @@ bool ggml_common_quantize_0(
         total_size_org += nelements * sizeof(float);
     }
 
+    if (qw && qw_used.size() != qw->w.size()) {
+        // stats with names that match no quantized tensor would silently turn variant C into B
+        for (const auto & kv : qw->w) {
+            if (!qw_used.count(kv.first)) {
+                fprintf(stderr, "%s: stats for '%s' were not used\n", __func__, kv.first.c_str());
+            }
+        }
+        return false;
+    }
+
     printf("%s: model size  = %8.2f MB\n", __func__, total_size_org/1024.0/1024.0);
