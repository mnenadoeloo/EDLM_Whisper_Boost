 }
+
+bool ggml_quant_weights_load(const char * fname, ggml_quant_weights & qw) {
+    std::ifstream f(fname, std::ios::binary);
+    if (!f) {
+        fprintf(stderr, "%s: failed to open '%s'\n", __func__, fname);
+        return false;
+    }
+    int32_t n = 0;
+    f.read(reinterpret_cast<char *>(&n), sizeof(n));
+    if (!f || n <= 0 || n > 100000) {
+        fprintf(stderr, "%s: '%s' is not a stats file (tensor count %d)\n", __func__, fname, n);
+        return false;
+    }
+    for (int32_t i = 0; i < n && f; ++i) {
+        int32_t len = 0, k = 0;
+        f.read(reinterpret_cast<char *>(&len), sizeof(len));
+        if (!f || len <= 0 || len > 4096) {
+            fprintf(stderr, "%s: bad name length %d in '%s'\n", __func__, len, fname);
+            return false;
+        }
+        std::string name(len, 0);
+        f.read(&name[0], len);
+        f.read(reinterpret_cast<char *>(&k), sizeof(k));
+        if (!f || k <= 0 || k > (1 << 20)) {
+            fprintf(stderr, "%s: bad vector length %d for '%s' in '%s'\n", __func__, k, name.c_str(), fname);
+            return false;
+        }
+        std::vector<float> v(k);
+        f.read(reinterpret_cast<char *>(v.data()), k * sizeof(float));
+        qw.w[name] = std::move(v);
+    }
+    if (!f) {
+        fprintf(stderr, "%s: truncated file '%s'\n", __func__, fname);
+        return false;
+    }
+    printf("%s: loaded stats for %zu tensors\n", __func__, qw.w.size());
+    return true;
+}
