{
  "source_model": "openai/whisper-small",
  "default": {
    "format": "Q4_0",
    "method": "rtn"
  },
  "rules": [
    {
      "pattern": "encoder.blocks.*.attn.key.weight",
      "format": "Q8_0",
      "method": "rtn"
    },
    {
      "pattern": "encoder.blocks.*.attn.value.weight",
      "format": "Q8_0",
      "method": "rtn"
    },
    {
      "pattern": "encoder.blocks.*.attn.out.weight",
      "format": "Q8_0",
      "method": "rtn"
    },
    {
      "pattern": "decoder.blocks.*.cross_attn.out.weight",
      "format": "Q8_0",
      "method": "rtn"
    }
  ]
}
